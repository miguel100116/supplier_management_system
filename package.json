{
  "name": "ms-form-analytics-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node scripts/run-tests.mjs",
    "test:import": "tsx --test scripts/supabase-import/cliOptions.test.ts scripts/supabase-import/importPlan.test.ts scripts/supabase-import/sqlImport.test.ts scripts/supabase-import/writer.test.ts",
    "import:supabase": "tsx scripts/supabase-import/cli.ts",
    "import:staging": "tsx scripts/supabase-import/stagingImport.ts",
    "generate:staging-import-sql": "tsx scripts/supabase-import/generateSqlImport.ts",
    "db:cleanup:tests:preview": "tsx scripts/database-cleanup/cli.ts --preview",
    "db:cleanup:tests:sql": "tsx scripts/database-cleanup/cli.ts --delete-sql",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm test && npm run build && npm run test:e2e && npm audit --audit-level=high",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.17.1",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/postcss": "4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "docx": "^9.5.1",
    "esbuild": "^0.28.1",
    "express": "^4.22.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "papaparse": "^5.4.1",
    "postcss": "^8.4.49",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
